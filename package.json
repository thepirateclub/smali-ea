{
  "name": "smali-editor-analyzer",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "smali",
    "android",
    "reverse-engineering",
    "decompiler",
    "editor"
  ],
  "author": "Smali Editor Team",
  "license": "ISC",
  "description": "A powerful Smali editor and analyzer tool with dependency visualization and method modification capabilities",
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "fs-extra": "^11.1.1",
    "chokidar": "^3.5.3"
  },
  "build": {
    "appId": "com.smali.editor",
    "productName": "Smali Editor & Analyzer",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "main.js",
      "preload.js",
      "icon.png",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "icon.png"
    }
  }
}